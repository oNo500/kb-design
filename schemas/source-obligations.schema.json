{
  "$id": "urn:kb-design:schema:source-obligations:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "obligations": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "open"
                }
              }
            },
            "then": {
              "properties": {
                "resolved": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "resolved"
                }
              }
            },
            "then": {
              "properties": {
                "resolved": {
                  "format": "date",
                  "type": "string"
                }
              }
            }
          }
        ],
        "properties": {
          "decisions": {
            "items": {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "type": "array"
          },
          "entity": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "history": {
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "opened": {
            "format": "date",
            "type": "string"
          },
          "previous": {
            "oneOf": [
              {
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolved": {
            "oneOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "targets": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "field_path": {
                  "minLength": 1,
                  "type": "string"
                },
                "file": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "basis",
                    "source",
                    "match",
                    "use_role",
                    "decision",
                    "obligation"
                  ]
                },
                "record": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "file",
                "record",
                "field_path"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "trigger": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "entity",
          "trigger",
          "targets",
          "decisions",
          "previous",
          "state",
          "opened",
          "resolved",
          "history"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "urn:kb-design:data:source-obligations"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "schema_version",
    "obligations"
  ],
  "type": "object"
}
