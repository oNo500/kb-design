{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kb-design:schema:term-obligations:1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "obligations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:kb-design:schema:term-obligations:1"
    },
    "version": {
      "const": 1
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "nullableDate": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableDecision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^decision-term-[0-9]{4}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "field_path",
        "conclusion",
        "reviewed",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "concept",
            "term",
            "delegation",
            "decision",
            "obligation",
            "generated_output"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed": {
          "$ref": "#/$defs/nullableDate"
        },
        "decision": {
          "$ref": "#/$defs/nullableDecision"
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "previous_obligation"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "source_obligation",
            "concept",
            "term",
            "language",
            "delegation",
            "decision",
            "homograph",
            "schema",
            "generation",
            "rollback"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "previous_obligation": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^term-review-[0-9]{8}-[0-9]{3}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "history": {
      "type": "object",
      "required": [
        "date",
        "event",
        "decision",
        "reason",
        "from_value",
        "to_value",
        "linked_terms"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/nullableDecision"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "from_value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "to_value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "linked_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tm-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "targets",
        "trigger",
        "state",
        "opened",
        "closed",
        "decision",
        "history"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^term-review-[0-9]{8}-[0-9]{3}$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "state": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "opened": {
          "$ref": "#/$defs/date"
        },
        "closed": {
          "$ref": "#/$defs/nullableDate"
        },
        "decision": {
          "$ref": "#/$defs/nullableDecision"
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/history"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "open"
              }
            }
          },
          "then": {
            "properties": {
              "closed": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "closed": {
                "$ref": "#/$defs/date"
              }
            }
          }
        }
      ]
    }
  }
}
