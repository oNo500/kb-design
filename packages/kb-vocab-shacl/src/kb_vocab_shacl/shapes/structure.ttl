@prefix resource: <urn:kb-vocab-shacl:resource:> .
@prefix common: <urn:kb-vocab-shacl:common:> .
@prefix field: <urn:kb-vocab-shacl:field:> .
@prefix rule: <urn:kb-vocab-shacl:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix iso-thes: <http://purl.org/iso25964/skos-thes#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# 完整资源结构：从 resource:Concept 等入口查看字段；sh:node 引用共同字段。
# sh:property 关联字段，sh:path 指定属性；可选字段也必须在此列出。
# 统计与结构校验都读取 read_shapes("structure")，无需另一份字段清单。
# 共享约束用 rule: 引用已有定义；加载器补齐定义，并只保留资源入口的检查目标。
# dcterms:relation 关联需明确对象后才执行的条件规则，不自动启用这些规则。
# 数据中的空字符串算字段已出现，是否合规由后续校验判断。

# resource:ConceptScheme：字段入口。
resource:ConceptScheme a sh:NodeShape ; sh:nodeKind sh:IRI ; sh:name "词表"@zh ;
    sh:targetClass skos:ConceptScheme ;
    sh:targetSubjectsOf skos:hasTopConcept ;
    sh:targetObjectsOf skos:inScheme, skos:topConceptOf ;
    sh:node common:Metadata, common:Evidence, common:Notes ;
    sh:property field:ConceptScheme_rdf_type,
        field:ConceptScheme_skos_prefLabel,
        rule:PreferredLiteral,
        field:ConceptScheme_skos_altLabel,
        rule:AlternativeLiteral,
        field:ConceptScheme_skos_hiddenLabel,
        rule:HiddenLiteral,
        field:ConceptScheme_skos_scopeNote,
        field:ConceptScheme_dcterms_description,
        rule:TextMetadata_dcterms_description,
        field:ConceptScheme_skos_note,
        field:ConceptScheme_skos_historyNote,
        field:ConceptScheme_skos_changeNote,
        field:ConceptScheme_skos_hasTopConcept,
        rule:TopTarget_hasTopConcept,
        field:ConceptScheme_dcterms_source,
        rule:ResourceEvidence_dcterms_source,
        field:ConceptScheme_dcterms_created,
        field:ConceptScheme_dcterms_modified,
        field:ConceptScheme_dcterms_language,
        field:ConceptScheme_owl_versionInfo,
        field:ConceptScheme_skosxl_prefLabel,
        rule:XLReference_prefLabel,
        field:ConceptScheme_skosxl_altLabel,
        rule:XLReference_altLabel,
        field:ConceptScheme_skosxl_hiddenLabel,
        rule:XLReference_hiddenLabel ;
    dcterms:relation rule:LocalDates .

# resource:Concept：字段入口。
resource:Concept a sh:NodeShape ; sh:nodeKind sh:IRI ; sh:name "概念"@zh ;
    sh:targetClass skos:Concept ;
    sh:targetSubjectsOf skos:broader, skos:narrower, skos:related, skos:broaderTransitive, skos:narrowerTransitive, skos:topConceptOf ;
    sh:targetObjectsOf skos:broader, skos:narrower, skos:related, skos:broaderTransitive, skos:narrowerTransitive, skos:hasTopConcept ;
    sh:node common:Metadata, common:Evidence, common:Notes ;
    sh:property field:Concept_rdf_type,
        field:Concept_skos_inScheme,
        field:Concept_skosxl_prefLabel,
        rule:XLReference_prefLabel,
        field:Concept_skosxl_altLabel,
        rule:XLReference_altLabel,
        field:Concept_skosxl_hiddenLabel,
        rule:XLReference_hiddenLabel,
        field:Concept_skos_notation,
        rule:TextMetadata_skos_notation,
        field:Concept_dcterms_identifier,
        rule:TextMetadata_dcterms_identifier,
        field:Concept_skos_definition,
        field:Concept_skos_scopeNote,
        field:Concept_dcterms_description,
        rule:TextMetadata_dcterms_description,
        field:Concept_skos_note,
        field:Concept_skos_editorialNote,
        field:Concept_skos_historyNote,
        field:Concept_skos_changeNote,
        field:Concept_owl_deprecated,
        rule:DeprecatedValue,
        field:Concept_dcterms_isReplacedBy,
        field:Concept_dcterms_replaces,
        field:Concept_skos_broader,
        rule:ConceptTarget_broader,
        field:Concept_skos_narrower,
        rule:ConceptTarget_narrower,
        field:Concept_skos_related,
        rule:ConceptTarget_related,
        field:Concept_skos_topConceptOf,
        rule:TopTarget_topConceptOf,
        field:Concept_dcterms_isPartOf,
        rule:ResourceEvidence_dcterms_isPartOf,
        field:Concept_dcterms_source,
        rule:ResourceEvidence_dcterms_source,
        field:Concept_prov_wasDerivedFrom,
        rule:ResourceEvidence_prov_wasDerivedFrom,
        field:Concept_dcterms_created,
        field:Concept_dcterms_modified,
        field:Concept_skos_exactMatch,
        rule:MappingTarget_exactMatch,
        field:Concept_skos_closeMatch,
        rule:MappingTarget_closeMatch,
        field:Concept_skos_broadMatch,
        rule:MappingTarget_broadMatch,
        field:Concept_skos_narrowMatch,
        rule:MappingTarget_narrowMatch,
        field:Concept_skos_relatedMatch,
        rule:MappingTarget_relatedMatch,
        field:Concept_skos_prefLabel,
        rule:PreferredLiteral,
        field:Concept_skos_altLabel,
        rule:AlternativeLiteral,
        field:Concept_skos_hiddenLabel,
        rule:HiddenLiteral ;
    dcterms:relation rule:LocalDates, rule:LocalConcept .

# resource:Label：字段入口。
resource:Label a sh:NodeShape ; sh:nodeKind sh:IRI ; sh:name "名称"@zh ;
    sh:targetClass skosxl:Label ;
    # 同时选中通过 XL 属性使用的名称，漏写类型也要统计和校验。
    sh:targetSubjectsOf skosxl:literalForm, skosxl:labelRelation ;
    sh:targetObjectsOf skosxl:prefLabel, skosxl:altLabel, skosxl:hiddenLabel, skosxl:labelRelation ;
    sh:node common:Metadata, common:Evidence, common:Notes ;
    sh:property field:Label_rdf_type,
        field:Label_skosxl_literalForm,
        rule:LabelLiteralForm,
        field:Label_skosxl_labelRelation ;
    dcterms:relation rule:LocalDates, rule:LocalLabel .

# resource:Collection：字段入口。
resource:Collection a sh:NodeShape ; sh:nodeKind sh:IRI ; sh:name "集合"@zh ;
    sh:targetClass skos:Collection, skos:OrderedCollection, iso-thes:ConceptGroup, iso-thes:ThesaurusArray ;
    sh:targetSubjectsOf skos:member, skos:memberList, iso-thes:superGroup, iso-thes:subGroup ;
    sh:targetObjectsOf iso-thes:superGroup, iso-thes:subGroup ;
    sh:node common:Metadata, common:Evidence, common:Notes ;
    sh:property field:Collection_rdf_type,
        field:Collection_skos_prefLabel,
        rule:PreferredLiteral,
        field:Collection_skos_altLabel,
        rule:AlternativeLiteral,
        field:Collection_skos_hiddenLabel,
        rule:HiddenLiteral,
        field:Collection_rdfs_label,
        rule:TextMetadata_rdfs_label,
        field:Collection_skos_notation,
        rule:TextMetadata_skos_notation,
        field:Collection_skos_scopeNote,
        field:Collection_skos_historyNote,
        field:Collection_skos_changeNote,
        field:Collection_dcterms_source,
        rule:ResourceEvidence_dcterms_source,
        field:Collection_prov_wasDerivedFrom,
        rule:ResourceEvidence_prov_wasDerivedFrom,
        field:Collection_skos_inScheme,
        field:Collection_skos_member,
        rule:CollectionMembers,
        field:Collection_skos_memberList,
        field:Collection_iso_thes_subGroup,
        field:Collection_iso_thes_superGroup,
        field:Collection_dcterms_created,
        field:Collection_dcterms_modified,
        field:Collection_skosxl_prefLabel,
        rule:XLReference_prefLabel,
        field:Collection_skosxl_altLabel,
        rule:XLReference_altLabel,
        field:Collection_skosxl_hiddenLabel,
        rule:XLReference_hiddenLabel,
        rule:DeclaredCollectionType ;
    dcterms:relation rule:LocalDates, rule:LocalCollection .

# resource:OrderedCollection：字段入口。
resource:OrderedCollection a sh:NodeShape ; sh:nodeKind sh:IRI ; sh:name "有序集合"@zh ;
    sh:targetClass skos:OrderedCollection ;
    sh:targetSubjectsOf skos:memberList ;
    sh:node resource:Collection ;
    sh:property field:OrderedCollection_rdf_type,
        field:OrderedCollection_skos_memberList .

# resource:ConceptGroup：字段入口。
resource:ConceptGroup a sh:NodeShape ; sh:nodeKind sh:IRI ; sh:name "概念组"@zh ;
    sh:targetClass iso-thes:ConceptGroup ;
    sh:targetSubjectsOf iso-thes:superGroup, iso-thes:subGroup ;
    sh:targetObjectsOf iso-thes:superGroup, iso-thes:subGroup ;
    sh:node resource:Collection ;
    sh:property field:ConceptGroup_rdf_type ;
    dcterms:relation rule:LocalConceptGroup, rule:LocalCollection .

# resource:ThesaurusArray：字段入口。
resource:ThesaurusArray a sh:NodeShape ; sh:nodeKind sh:IRI ; sh:name "数组"@zh ;
    sh:targetClass iso-thes:ThesaurusArray ;
    sh:node resource:Collection ;
    sh:property field:ThesaurusArray_rdf_type .

# resource:Note：字段入口。
resource:Note a sh:NodeShape ; sh:name "独立说明"@zh ;
    sh:node common:Metadata, common:Evidence ;
    sh:property field:Note_rdf_value ;
    dcterms:relation rule:LocalDates, rule:LocalNote .

# common:Metadata：字段入口。
common:Metadata a sh:NodeShape ;
    sh:property field:Metadata_dcterms_title,
        rule:TextMetadata_dcterms_title,
        field:Metadata_dcterms_identifier,
        rule:TextMetadata_dcterms_identifier,
        field:Metadata_dc_creator,
        field:Metadata_dc_contributor,
        field:Metadata_dc_publisher,
        field:Metadata_dc_subject,
        field:Metadata_dcterms_subject,
        field:Metadata_dcterms_type,
        field:Metadata_dcterms_format,
        field:Metadata_dcterms_conformsTo,
        field:Metadata_dcterms_language,
        field:Metadata_dcterms_isRequiredBy,
        field:Metadata_dcterms_replaces,
        field:Metadata_dcterms_license,
        field:Metadata_dcterms_rights,
        field:Metadata_dcterms_rightsHolder,
        field:Metadata_dcterms_created,
        field:Metadata_dcterms_modified,
        field:Metadata_owl_versionInfo,
        field:Metadata_owl_imports .

# common:Notes：字段入口。
common:Notes a sh:NodeShape ;
    sh:property field:Notes_skos_definition,
        field:Notes_skos_scopeNote,
        field:Notes_skos_example,
        field:Notes_skos_note,
        field:Notes_skos_editorialNote,
        field:Notes_skos_historyNote,
        field:Notes_skos_changeNote,
        field:Notes_dcterms_description,
        rule:TextMetadata_dcterms_description .

# common:Evidence：字段入口。
common:Evidence a sh:NodeShape ;
    sh:property field:Evidence_dcterms_source,
        rule:ResourceEvidence_dcterms_source,
        field:Evidence_prov_wasDerivedFrom,
        rule:ResourceEvidence_prov_wasDerivedFrom .

# 四种名称文字路径共用同一个非空约束；不导入耗时的关系查询。
rule:PreferredLiteral sh:node rule:NonemptyNameValue .
rule:AlternativeLiteral sh:node rule:NonemptyNameValue .
rule:HiddenLiteral sh:node rule:NonemptyNameValue .
rule:LabelLiteralForm sh:node rule:NonemptyNameValue .

# 以下为字段定义；同一路径的共同约束与对象专用约束同时适用。

# dcterms:title：0..n。
field:Metadata_dcterms_title a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:name "dcterms:title" ;
    sh:description "0..n；标题文字及原语言；与首选标签可同值也可不同，按实际含义保存，不强制相互派生"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:identifier：0..n。
field:Metadata_dcterms_identifier a sh:PropertyShape ;
    sh:path dcterms:identifier ;
    sh:name "dcterms:identifier" ;
    sh:description "0..n；来源标识文字及原类型，不替代资源 IRI"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dc:creator：各 0..n。
field:Metadata_dc_creator a sh:PropertyShape ;
    sh:path dc:creator ;
    sh:name "dc:creator" ;
    sh:description "各 0..n；来源中的文字或资源引用；分别说明创建者、贡献者和发布者，不自动转成自有元数据"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dc:contributor：各 0..n。
field:Metadata_dc_contributor a sh:PropertyShape ;
    sh:path dc:contributor ;
    sh:name "dc:contributor" ;
    sh:description "各 0..n；来源中的文字或资源引用；分别说明创建者、贡献者和发布者，不自动转成自有元数据"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dc:publisher：各 0..n。
field:Metadata_dc_publisher a sh:PropertyShape ;
    sh:path dc:publisher ;
    sh:name "dc:publisher" ;
    sh:description "各 0..n；来源中的文字或资源引用；分别说明创建者、贡献者和发布者，不自动转成自有元数据"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dc:subject：各 0..n。
field:Metadata_dc_subject a sh:PropertyShape ;
    sh:path dc:subject ;
    sh:name "dc:subject" ;
    sh:description "各 0..n；主题文字或资源引用；优先保留已有受控身份，不据此自动建立本地概念关系"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:subject：各 0..n。
field:Metadata_dcterms_subject a sh:PropertyShape ;
    sh:path dcterms:subject ;
    sh:name "dcterms:subject" ;
    sh:description "各 0..n；主题文字或资源引用；优先保留已有受控身份，不据此自动建立本地概念关系"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:type：0..n。
field:Metadata_dcterms_type a sh:PropertyShape ;
    sh:path dcterms:type ;
    sh:name "dcterms:type" ;
    sh:description "0..n；类别资源引用或文字；保留已有受控类型，不用类别字符串代替 rdf:type 或本地分类决定"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:format：0..n。
field:Metadata_dcterms_format a sh:PropertyShape ;
    sh:path dcterms:format ;
    sh:name "dcterms:format" ;
    sh:description "0..n；格式、介质或尺寸的资源引用或文字，如媒体类型字符串；不冒称自有输出的格式"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:conformsTo：0..n。
field:Metadata_dcterms_conformsTo a sh:PropertyShape ;
    sh:path dcterms:conformsTo ;
    sh:name "dcterms:conformsTo" ;
    sh:description "0..n；标准引用及来源原有表述；自有符合性声明须有明确对象和证据"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:language：0..n。
field:Metadata_dcterms_language a sh:PropertyShape ;
    sh:path dcterms:language ;
    sh:name "dcterms:language" ;
    sh:description "0..n；受控语言资源或 BCP 47 文字值；资源级语言声明不代替每条名称的标签"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:isRequiredBy：各 0..n。
field:Metadata_dcterms_isRequiredBy a sh:PropertyShape ;
    sh:path dcterms:isRequiredBy ;
    sh:name "dcterms:isRequiredBy" ;
    sh:description "各 0..n；按属性含义保留所指资源；来源文档替代与概念替代分别解释"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:replaces：各 0..n。
field:Metadata_dcterms_replaces a sh:PropertyShape ;
    sh:path dcterms:replaces ;
    sh:name "dcterms:replaces" ;
    sh:description "各 0..n；按属性含义保留所指资源；来源文档替代与概念替代分别解释"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:license：0..n。
field:Metadata_dcterms_license a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:name "dcterms:license" ;
    sh:description "0..n；优先引用许可文档；无法使用 URI 时可保留能识别许可的文字，不擅自变更许可"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:rights：各 0..n。
field:Metadata_dcterms_rights a sh:PropertyShape ;
    sh:path dcterms:rights ;
    sh:name "dcterms:rights" ;
    sh:description "各 0..n；分别为权利声明和权利持有者；保留资源引用或能识别对象的文字，不为格式统一造实体"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:rightsHolder：各 0..n。
field:Metadata_dcterms_rightsHolder a sh:PropertyShape ;
    sh:path dcterms:rightsHolder ;
    sh:name "dcterms:rightsHolder" ;
    sh:description "各 0..n；分别为权利声明和权利持有者；保留资源引用或能识别对象的文字，不为格式统一造实体"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:created：来源各 0..n。
field:Metadata_dcterms_created a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:name "dcterms:created" ;
    sh:description "来源各 0..n；保留原主体、版本、数量及时间精度；本地记录按独立日期约定处理"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# dcterms:modified：来源各 0..n。
field:Metadata_dcterms_modified a sh:PropertyShape ;
    sh:path dcterms:modified ;
    sh:name "dcterms:modified" ;
    sh:description "来源各 0..n；保留原主体、版本、数量及时间精度；本地记录按独立日期约定处理"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# owl:versionInfo：0..n。
field:Metadata_owl_versionInfo a sh:PropertyShape ;
    sh:path owl:versionInfo ;
    sh:name "owl:versionInfo" ;
    sh:description "0..n；来源版本说明，不覆盖自有词表或工具版本"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# owl:imports：0..n。
field:Metadata_owl_imports a sh:PropertyShape ;
    sh:path owl:imports ;
    sh:name "owl:imports" ;
    sh:description "0..n；允许保留来源的导入声明；读取时不自动加载外部图。"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" .

# skos:definition：0..n 个说明值。
field:Notes_skos_definition a sh:PropertyShape ;
    sh:path skos:definition ;
    sh:name "skos:definition" ;
    sh:description "0..n 个说明值；定义；来源附着于概念或名称时保留原位置"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#说明字段" .

# skos:scopeNote：0..n 个说明值。
field:Notes_skos_scopeNote a sh:PropertyShape ;
    sh:path skos:scopeNote ;
    sh:name "skos:scopeNote" ;
    sh:description "0..n 个说明值；使用范围；词表与自建集合按各自字段表必填"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#说明字段" .

# skos:example：0..n 个说明值。
field:Notes_skos_example a sh:PropertyShape ;
    sh:path skos:example ;
    sh:name "skos:example" ;
    sh:description "0..n 个说明值；所解释对象的使用示例"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#说明字段" .

# skos:note：0..n 个说明值。
field:Notes_skos_note a sh:PropertyShape ;
    sh:path skos:note ;
    sh:name "skos:note" ;
    sh:description "0..n 个说明值；不适合归入更具体属性的说明"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#说明字段" .

# skos:editorialNote：0..n 个说明值。
field:Notes_skos_editorialNote a sh:PropertyShape ;
    sh:path skos:editorialNote ;
    sh:name "skos:editorialNote" ;
    sh:description "0..n 个说明值；编辑提醒，默认保留在管理输出"@zh ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#说明字段" .

# skos:historyNote：0..n 个说明值。
field:Notes_skos_historyNote a sh:PropertyShape ;
    sh:path skos:historyNote ;
    sh:name "skos:historyNote" ;
