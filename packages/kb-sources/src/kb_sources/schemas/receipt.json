{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source", "acquired_at", "request_sha256", "tool", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "requested_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "requested_version": {"type": "string", "minLength": 1}
      }
    },
    "acquired_at": {"type": "string", "format": "date-time"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"const": "kb-sources"}, "version": {"type": "string"}}
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "filename", "format", "url", "final_url", "size", "sha256", "content_type"],
        "properties": {
          "id": {"type": "string"},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "format": {"enum": ["pdf", "html", "tsv", "turtle", "xml", "zip", "json"]},
          "url": {"type": "string", "format": "uri"},
          "final_url": {"type": "string", "format": "uri"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_type": {"type": "string"}
        }
      }
    }
  }
}
