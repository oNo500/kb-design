rule:LocalNote a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#说明字段" ;
    sh:message "本地独立说明的完整性要求"@zh ;
    sh:name "本地独立说明的完整性要求"@zh ;
    sh:property rule:LocalNoteBody ;
    sh:severity sh:Violation .

rule:MainTypeIRI a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#标识与类型" ;
    sh:message "主要记录的类型声明须使用 IRI。"@zh ;
    sh:name "主要记录的类型使用 IRI"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path rdf:type ;
    sh:severity sh:Violation ;
    sh:targetClass iso:ConceptGroup,
        iso:ThesaurusArray,
        skos:Collection,
        skos:Concept,
        skos:ConceptScheme,
        skos:OrderedCollection,
        xl:Label .

rule:MappingTarget_broadMatch a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#映射字段" ;
    sh:message "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:name "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:broadMatch ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:broadMatch .

rule:MappingTarget_closeMatch a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#映射字段" ;
    sh:message "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:name "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:closeMatch ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:closeMatch .

rule:MappingTarget_exactMatch a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#映射字段" ;
    sh:message "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:name "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:exactMatch ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:exactMatch .

rule:MappingTarget_narrowMatch a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#映射字段" ;
    sh:message "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:name "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:narrowMatch ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:narrowMatch .

rule:MappingTarget_relatedMatch a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#映射字段" ;
    sh:message "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:name "映射端点使用 IRI；外部端点类型另由限定来源上下文核对"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:relatedMatch ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:relatedMatch .

rule:MemberValueType a sh:NodeShape ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#collections> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#集合字段" ;
    sh:message "集合成员不能兼作概念体系或名称。"@zh ;
    sh:name "集合成员类型互斥"@zh ;
    sh:not [ sh:or ( rule:AsScheme rule:AsLabel ) ] ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf skos:member .

rule:MissingConceptName a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#概念字段" ;
    sh:message "概念缺少首选名称；来源缺项保留并核对"@zh ;
    sh:minCount 1 ;
    sh:name "概念缺少首选名称；来源缺项保留并核对"@zh ;
    sh:path [ sh:alternativePath ( skos:prefLabel ( xl:prefLabel xl:literalForm ) ) ] ;
    sh:severity sh:Warning ;
    sh:targetClass skos:Concept .

rule:MissingNameLanguage a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#语言与名称" ;
    sh:message "名称未标语言；保留原值并核对，不推断或补写语言。"@zh ;
    sh:name "名称语言缺项"@zh ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:select """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        PREFIX xl: <http://www.w3.org/2008/05/skos-xl#>
        SELECT DISTINCT $this ?path ?value WHERE {
            $this ?path ?value .
            FILTER(?path IN (skos:prefLabel, skos:altLabel, skos:hiddenLabel, xl:literalForm))
            FILTER(isLiteral(?value) && LANG(?value) = "")
        }
    """ ] ;
    sh:targetSubjectsOf skos:altLabel,
        skos:hiddenLabel,
        skos:prefLabel,
        xl:literalForm .

rule:NonemptyLabels a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#值与数量" ;
    sh:message "名称文字不能为空"@zh ;
    sh:name "名称文字不能为空"@zh ;
    sh:node rule:NonemptyNameValue ;
    sh:path [ sh:alternativePath ( skos:prefLabel skos:altLabel skos:hiddenLabel xl:literalForm ) ] ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:altLabel,
        skos:hiddenLabel,
        skos:prefLabel,
        xl:literalForm .

rule:OrderedListRequired a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#集合字段" ;
    sh:maxCount 1 ;
    sh:message "有序集合必须明确提供一个成员列表"@zh ;
    sh:minCount 1 ;
    sh:name "有序集合必须明确提供一个成员列表"@zh ;
    sh:path skos:memberList ;
    sh:severity sh:Violation ;
    sh:targetClass skos:OrderedCollection .

rule:OrderedListStructure a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#集合字段" ;
    sh:message "成员列表必须完整、有限、无循环并以 rdf:nil 结束"@zh ;
    sh:name "成员列表必须完整、有限、无循环并以 rdf:nil 结束"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX iso: <http://purl.org/iso25964/skos-thes#>
SELECT DISTINCT $this ?path WHERE {
    # 报告集合和出错字段，不复制循环列表本身，避免生成报告时陷入递归。
    BIND(skos:memberList AS ?path)
    $this skos:memberList ?head .
    {
        ?head rdf:rest* ?value . FILTER(?value != rdf:nil)
        FILTER(!isBlank(?value) && !isIRI(?value))
    } UNION {
        ?head rdf:rest* ?value . FILTER(?value != rdf:nil)
        FILTER NOT EXISTS { ?value rdf:first ?item }
    } UNION {
        ?head rdf:rest* ?value . FILTER(?value != rdf:nil)
        FILTER NOT EXISTS { ?value rdf:rest ?next }
    } UNION {
        ?head rdf:rest* ?value . ?value rdf:first ?a, ?b . FILTER(?a != ?b)
    } UNION {
        ?head rdf:rest* ?value . ?value rdf:rest ?a, ?b . FILTER(?a != ?b)
    } UNION {
        ?head rdf:rest* ?value . ?value rdf:rest+ ?value .
    } UNION {
        ?head rdf:rest* rdf:nil . rdf:nil (rdf:first|rdf:rest) ?value .
    }
}
    """ ] ;
    sh:targetClass skos:OrderedCollection ;
    sh:targetSubjectsOf skos:memberList .

rule:OrderedMembersProjection a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#派生表达" ;
    sh:equals skos:member ;
    sh:message "有序集合的 member 必须与列表成员投影一致"@zh ;
    sh:name "有序集合的 member 必须与列表成员投影一致"@zh ;
    sh:path ( skos:memberList [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
    sh:severity sh:Violation ;
    sh:targetClass skos:OrderedCollection .

rule:PreferredLiteral a sh:PropertyShape ;
    dcterms:source <https://www.w3.org/TR/skos-reference/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#语言与名称" ;
    sh:message "普通标签必须是带语言或不带语言的文字"@zh ;
    sh:name "普通标签必须是带语言或不带语言的文字"@zh ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path skos:prefLabel ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:prefLabel .

rule:PreferredTextUnique a sh:PropertyShape ;
    dcterms:source <https://www.w3.org/TR/skos-reference/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#语言与名称" ;
    sh:message "同一完整语言标签只能有一个不同的首选文字"@zh ;
    sh:name "同一完整语言标签只能有一个不同的首选文字"@zh ;
    sh:path [ sh:alternativePath ( skos:prefLabel ( xl:prefLabel xl:literalForm ) ) ] ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:altLabel,
        skos:hiddenLabel,
        skos:prefLabel,
        xl:altLabel,
        xl:hiddenLabel,
        xl:prefLabel ;
    sh:uniqueLang true .

rule:RelatedHierarchyConflict a sh:NodeShape ;
    dcterms:source <https://www.w3.org/TR/skos-reference/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#标准一致性" ;
    sh:message "相关关系不能与同一对概念的层级可达关系重叠"@zh ;
    sh:name "相关关系不能与同一对概念的层级可达关系重叠"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX iso: <http://purl.org/iso25964/skos-thes#>
SELECT DISTINCT $this ?value WHERE {
    $this (skos:related|^skos:related|skos:relatedMatch|^skos:relatedMatch) ?value .
    $this (skos:broader|^skos:narrower|skos:broaderTransitive|^skos:narrowerTransitive|skos:broadMatch|^skos:narrowMatch)+ ?value .
}
    """ ] ;
    sh:targetClass skos:Concept ;
    sh:targetObjectsOf skos:related,
        skos:relatedMatch ;
    sh:targetSubjectsOf skos:related,
        skos:relatedMatch .

rule:ReplacementIdentity a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#概念字段" ;
    sh:message "概念替代对象须使用 IRI；外部或历史描述由指定上下文核对。"@zh ;
    sh:name "概念替代对象的标识"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path [ sh:alternativePath ( dcterms:isReplacedBy dcterms:replaces ) ] ;
    sh:severity sh:Violation ;
    sh:targetClass skos:Concept .

rule:ResourceEvidence_dcterms_isPartOf a sh:PropertyShape ;
    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path dcterms:isPartOf ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf dcterms:isPartOf .

rule:ResourceEvidence_dcterms_source a sh:PropertyShape ;
    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path dcterms:source ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf dcterms:source .

rule:ResourceEvidence_prov_wasDerivedFrom a sh:PropertyShape ;
    dcterms:source <https://www.w3.org/TR/prov-o/#wasDerivedFrom> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path prov:wasDerivedFrom ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf prov:wasDerivedFrom .

rule:SchemeIdentity a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#词表字段" ;
    sh:message "概念体系使用稳定 IRI"@zh ;
    sh:name "概念体系使用稳定 IRI"@zh ;
    sh:nodeKind sh:IRI ;
    sh:property rule:DeclaredSchemeType ;
    sh:severity sh:Violation ;
    sh:targetClass skos:ConceptScheme ;
    sh:targetObjectsOf skos:inScheme,
        skos:topConceptOf ;
    sh:targetSubjectsOf skos:hasTopConcept .

rule:SchemeName a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#词表字段" ;
    sh:message "自有词表需要首选名称"@zh ;
    sh:minCount 1 ;
    sh:name "自有词表需要首选名称"@zh ;
    sh:path [ sh:alternativePath ( skos:prefLabel ( xl:prefLabel xl:literalForm ) ) ] ;
    sh:severity sh:Violation ;
    sh:targetClass skos:ConceptScheme .

rule:SchemeScope a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#词表字段" ;
    sh:message "自有词表需要范围说明"@zh ;
    sh:minCount 1 ;
    sh:name "自有词表需要范围说明"@zh ;
    sh:path skos:scopeNote ;
    sh:severity sh:Violation ;
    sh:targetClass skos:ConceptScheme .

rule:SelfRelatedDiagnostic a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#层级判据" ;
    sh:message "存在自相关；核对来源、用途及变更依据。"@zh ;
    sh:name "自相关复核"@zh ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:select """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT $this ?path WHERE {
            $this skos:related $this . BIND(skos:related AS ?path)
        }
    """ ] ;
    sh:targetSubjectsOf skos:related .

rule:SemanticEndpointType a sh:NodeShape ;
    dcterms:source <https://www.w3.org/TR/skos-reference/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#关系约束" ;
    sh:message "概念关系端点不能同时是集合、名称或概念体系"@zh ;
    sh:name "概念关系端点不能同时是集合、名称或概念体系"@zh ;
    sh:not [ sh:or ( rule:AsCollection rule:AsScheme rule:AsLabel ) ] ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf skos:broadMatch,
        skos:broader,
        skos:broaderTransitive,
        skos:closeMatch,
        skos:exactMatch,
        skos:hasTopConcept,
        skos:mappingRelation,
        skos:narrowMatch,
        skos:narrower,
        skos:narrowerTransitive,
        skos:related,
        skos:relatedMatch,
        skos:semanticRelation ;
    sh:targetSubjectsOf skos:broadMatch,
        skos:broader,
        skos:broaderTransitive,
        skos:closeMatch,
        skos:exactMatch,
        skos:mappingRelation,
        skos:narrowMatch,
        skos:narrower,
        skos:narrowerTransitive,
        skos:related,
        skos:relatedMatch,
        skos:semanticRelation,
        skos:topConceptOf .

rule:SingleScheme a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#标准与选择" ;
    sh:message "最终主图必须恰好包含一个自有概念体系"@zh ;
    sh:name "最终主图必须恰好包含一个自有概念体系"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX iso: <http://purl.org/iso25964/skos-thes#>
SELECT DISTINCT $this WHERE { {
    FILTER NOT EXISTS { ?s a skos:ConceptScheme }
} UNION {
    ?s a skos:ConceptScheme . ?other a skos:ConceptScheme . FILTER(?s != ?other)
} }
    """ ] ;
    sh:targetNode rule:Dataset .

rule:TextMetadata_dcterms_description a sh:PropertyShape ;
    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:Literal ;
    sh:path dcterms:description ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf dcterms:description .

rule:TextMetadata_dcterms_identifier a sh:PropertyShape ;
    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:Literal ;
    sh:path dcterms:identifier ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf dcterms:identifier .

rule:TextMetadata_dcterms_title a sh:PropertyShape ;
    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:Literal ;
    sh:path dcterms:title ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf dcterms:title .

rule:TextMetadata_rdfs_label a sh:PropertyShape ;
    dcterms:source <https://www.w3.org/TR/rdf-schema/#ch_label> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:label ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf rdfs:label .

rule:TextMetadata_skos_notation a sh:PropertyShape ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#notations> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源兼容字段" ;
    sh:message "元数据的值类型须符合字段职责"@zh ;
    sh:name "元数据的值类型须符合字段职责"@zh ;
    sh:nodeKind sh:Literal ;
    sh:path skos:notation ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:notation .

rule:TopMembership a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#词表字段" ;
    sh:message "指定顶层必须是该词表成员"@zh ;
    sh:name "指定顶层必须是该词表成员"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX iso: <http://purl.org/iso25964/skos-thes#>
SELECT $this ?value WHERE {
    $this skos:hasTopConcept ?value . FILTER NOT EXISTS { ?value skos:inScheme $this }
}
    """ ] ;
    sh:targetSubjectsOf skos:hasTopConcept .

rule:TopTarget_hasTopConcept a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#词表字段" ;
    sh:class skos:Concept ;
    sh:message "顶层关系指向相应概念或概念体系"@zh ;
    sh:name "顶层关系指向相应概念或概念体系"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:hasTopConcept ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:hasTopConcept .

rule:TopTarget_topConceptOf a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#词表字段" ;
    sh:class skos:ConceptScheme ;
    sh:message "顶层关系指向相应概念或概念体系"@zh ;
    sh:name "顶层关系指向相应概念或概念体系"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:topConceptOf ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf skos:topConceptOf .

rule:XLProjection a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#派生表达" ;
    sh:message "采用的 XL 名称必须提供对应普通标签投影"@zh ;
    sh:name "采用的 XL 名称必须提供对应普通标签投影"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX iso: <http://purl.org/iso25964/skos-thes#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this ?xlRole ?label . ?label xl:literalForm ?value .
    FILTER(?xlRole IN (xl:prefLabel, xl:altLabel, xl:hiddenLabel))
    BIND(IF(?xlRole = xl:prefLabel, skos:prefLabel,
            IF(?xlRole = xl:altLabel, skos:altLabel, skos:hiddenLabel)) AS ?path)
    FILTER NOT EXISTS { $this ?path ?value }
}
    """ ] ;
    sh:targetSubjectsOf xl:altLabel,
        xl:hiddenLabel,
        xl:prefLabel .

rule:XLReference_altLabel a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#名称字段" ;
    sh:class xl:Label ;
    sh:message "XL 名称引用指向明确的 Label 记录"@zh ;
    sh:name "XL 名称引用指向明确的 Label 记录"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path xl:altLabel ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf xl:altLabel .

rule:XLReference_hiddenLabel a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#名称字段" ;
    sh:class xl:Label ;
    sh:message "XL 名称引用指向明确的 Label 记录"@zh ;
    sh:name "XL 名称引用指向明确的 Label 记录"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path xl:hiddenLabel ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf xl:hiddenLabel .

rule:XLReference_prefLabel a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#名称字段" ;
    sh:class xl:Label ;
    sh:message "XL 名称引用指向明确的 Label 记录"@zh ;
    sh:name "XL 名称引用指向明确的 Label 记录"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path xl:prefLabel ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf xl:prefLabel .

rule:XLRoleDisjoint a sh:NodeShape ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#xl> ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#语言与名称" ;
    sh:message "同一资源不能在互斥角色中引用同一名称记录"@zh ;
    sh:name "同一资源不能在互斥角色中引用同一名称记录"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX iso: <http://purl.org/iso25964/skos-thes#>
SELECT DISTINCT $this ?value WHERE { {
    $this xl:prefLabel ?value . $this (xl:altLabel|xl:hiddenLabel) ?value .
} UNION {
    $this xl:altLabel ?value . $this xl:hiddenLabel ?value .
} }
    """ ] ;
    sh:targetSubjectsOf xl:altLabel,
        xl:hiddenLabel,
        xl:prefLabel .

rule:ConceptTarget_broader a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#概念字段" ;
    sh:class skos:Concept ;
    sh:message "概念关系目标须为可定位的 Concept IRI"@zh ;
    sh:name "概念关系目标须为可定位的 Concept IRI"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:broader ;
    sh:severity sh:Violation .

rule:ConceptTarget_narrower a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#概念字段" ;
    sh:class skos:Concept ;
    sh:message "概念关系目标须为可定位的 Concept IRI"@zh ;
    sh:name "概念关系目标须为可定位的 Concept IRI"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:narrower ;
    sh:severity sh:Violation .

rule:ConceptTarget_related a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#概念字段" ;
    sh:class skos:Concept ;
    sh:message "概念关系目标须为可定位的 Concept IRI"@zh ;
    sh:name "概念关系目标须为可定位的 Concept IRI"@zh ;
    sh:nodeKind sh:IRI ;
    sh:path skos:related ;
    sh:severity sh:Violation .

rule:DeclaredCollectionType a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#集合字段" ;
    sh:message "目标集合须直接声明 skos:Collection 或 skos:OrderedCollection；扩展类型不替代该字段要求。"@zh ;
    sh:name "显式集合类型"@zh ;
    sh:path rdf:type ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:in ( skos:Collection skos:OrderedCollection ) ] ;
    sh:severity sh:Violation .

rule:DeclaredConceptType a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#概念字段" ;
    sh:hasValue skos:Concept ;
    sh:message "目标记录须直接声明 skos:Concept 类型；子类推导不替代该字段要求。"@zh ;
    sh:name "显式类型声明"@zh ;
    sh:path rdf:type ;
    sh:severity sh:Violation .

rule:DeclaredGroupType a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#分组扩展" ;
    sh:hasValue iso:ConceptGroup ;
    sh:message "目标记录须直接声明 iso:ConceptGroup 类型；子类推导不替代该字段要求。"@zh ;
    sh:name "显式类型声明"@zh ;
    sh:path rdf:type ;
    sh:severity sh:Violation .

rule:DeclaredLabelType a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#名称字段" ;
    sh:hasValue xl:Label ;
    sh:message "目标记录须直接声明 xl:Label 类型；子类推导不替代该字段要求。"@zh ;
    sh:name "显式类型声明"@zh ;
    sh:path rdf:type ;
    sh:severity sh:Violation .

rule:DeclaredSchemeType a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#词表字段" ;
    sh:hasValue skos:ConceptScheme ;
    sh:message "目标记录须直接声明 skos:ConceptScheme 类型；子类推导不替代该字段要求。"@zh ;
    sh:name "显式类型声明"@zh ;
    sh:path rdf:type ;
    sh:severity sh:Violation .

rule:LocalCollectionScheme a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#集合字段" ;
    sh:class skos:ConceptScheme ;
    sh:maxCount 1 ;
    sh:message "自有集合必须关联唯一词表"@zh ;
    sh:minCount 1 ;
    sh:name "自有集合必须关联唯一词表"@zh ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation .

rule:LocalCollectionScope a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#集合字段" ;
    sh:message "自建集合必须说明范围或引用组织依据"@zh ;
    sh:minCount 1 ;
    sh:name "自建集合必须说明范围或引用组织依据"@zh ;
    sh:path skos:scopeNote ;
    sh:severity sh:Violation .

rule:LocalConceptName a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#概念字段" ;
    sh:message "本地新增概念必须具有 XL 首选名称"@zh ;
    sh:minCount 1 ;
    sh:name "本地新增概念必须具有 XL 首选名称"@zh ;
    sh:path xl:prefLabel ;
    sh:severity sh:Violation .

rule:LocalCreated a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源与依据" ;
    sh:maxCount 1 ;
    sh:message "本地日期为可选单值 date 或 dateTime"@zh ;
    sh:name "本地日期为可选单值 date 或 dateTime"@zh ;
    sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
    sh:path dcterms:created ;
    sh:severity sh:Violation .

rule:LocalGroupName a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#集合名称" ;
    sh:message "本地概念组必须有明确名称"@zh ;
    sh:minCount 1 ;
    sh:name "本地概念组必须有明确名称"@zh ;
    sh:path [ sh:alternativePath ( skos:prefLabel ( xl:prefLabel xl:literalForm ) ) ] ;
    sh:severity sh:Violation .

rule:LocalLabelLanguage a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#名称字段" ;
    sh:datatype rdf:langString ;
    sh:message "本地新增名称必须明确语言"@zh ;
    sh:name "本地新增名称必须明确语言"@zh ;
    sh:path xl:literalForm ;
    sh:severity sh:Violation .

rule:LocalModified a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#来源与依据" ;
    sh:maxCount 1 ;
    sh:message "本地日期为可选单值 date 或 dateTime"@zh ;
    sh:name "本地日期为可选单值 date 或 dateTime"@zh ;
    sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
    sh:path dcterms:modified ;
    sh:severity sh:Violation .

rule:LocalNoteBody a sh:PropertyShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#说明字段" ;
    sh:datatype rdf:langString ;
    sh:maxCount 1 ;
    sh:message "本地独立说明恰好有一个带语言的正文"@zh ;
    sh:minCount 1 ;
    sh:name "本地独立说明恰好有一个带语言的正文"@zh ;
    sh:path rdf:value ;
    sh:severity sh:Violation .

rule:NonemptyNameValue a sh:NodeShape ;
    rdfs:comment "docs/model/vocabulary/设计-词表数据规范.md#值与数量" ;
    sh:message "名称文字不能为空。"@zh ;
    sh:minLength 1 ;
    sh:name "名称文字非空"@zh ;
    sh:severity sh:Violation .

rule:AsCollection a sh:NodeShape ;
    sh:or ( [ sh:class skos:Collection ] [ sh:class skos:OrderedCollection ] [ sh:class iso:ConceptGroup ] [ sh:class iso:ThesaurusArray ] [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:alternativePath ( skos:member skos:memberList iso:superGroup iso:subGroup [ sh:inversePath iso:superGroup ] [ sh:inversePath iso:subGroup ] ) ] ] ] ) .

rule:AsConcept a sh:NodeShape ;
    sh:or ( [ sh:class skos:Concept ] [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:alternativePath ( skos:semanticRelation skos:mappingRelation skos:broader skos:narrower skos:related skos:broaderTransitive skos:narrowerTransitive skos:exactMatch skos:closeMatch skos:broadMatch skos:narrowMatch skos:relatedMatch [ sh:inversePath skos:semanticRelation ] [ sh:inversePath skos:mappingRelation ] [ sh:inversePath skos:broader ] [ sh:inversePath skos:narrower ] [ sh:inversePath skos:related ] [ sh:inversePath skos:broaderTransitive ] [ sh:inversePath skos:narrowerTransitive ] [ sh:inversePath skos:exactMatch ] [ sh:inversePath skos:closeMatch ] [ sh:inversePath skos:broadMatch ] [ sh:inversePath skos:narrowMatch ] [ sh:inversePath skos:relatedMatch ] skos:topConceptOf [ sh:inversePath skos:hasTopConcept ] ) ] ] ] ) .

rule:AsLabel a sh:NodeShape ;
    sh:or ( [ sh:class xl:Label ] [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:alternativePath ( xl:literalForm xl:labelRelation [ sh:inversePath xl:labelRelation ] [ sh:inversePath xl:prefLabel ] [ sh:inversePath xl:altLabel ] [ sh:inversePath xl:hiddenLabel ] ) ] ] ] ) .

rule:AsScheme a sh:NodeShape ;
    sh:or ( [ sh:class skos:ConceptScheme ] [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:alternativePath ( skos:hasTopConcept [ sh:inversePath skos:inScheme ] [ sh:inversePath skos:topConceptOf ] ) ] ] ] ) .

